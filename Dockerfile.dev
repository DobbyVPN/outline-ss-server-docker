ARG GO_VERSION=1.24.8
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-alpine AS build

ARG TARGETARCH TARGETVARIANT BINARY_VERSION

WORKDIR /src
COPY upstream/ ./

RUN set -eu; \
    case "${TARGETARCH}-${TARGETVARIANT}" in \
      amd64-*) GOARCH=amd64; GOARM= ;; \
      arm64-*) GOARCH=arm64; GOARM= ;; \
      arm-v7) GOARCH=arm; GOARM=7 ;; \
      arm-v6) GOARCH=arm; GOARM=6 ;; \
      *) echo "unsupported architecture ${TARGETARCH}${TARGETVARIANT}"; exit 1 ;; \
    esac; \
    mkdir -p /out; \
    CGO_ENABLED=0 GOOS=linux GOARCH="$GOARCH" GOARM="$GOARM" GOWORK=off GOTOOLCHAIN=local \
      go build -trimpath -buildvcs=false -ldflags="-X main.version=${BINARY_VERSION}" \
        -o /out/outline-ss-server ./cmd/outline-ss-server

FROM alpine:3.19

ARG IMAGE_VERSION WRAPPER_SHA UPSTREAM_SHA UPSTREAM_DATE
ARG IMAGE_SOURCE="https://github.com/DobbyVPN/outline-tunnel-server"
ARG IMAGE_REVISION=$WRAPPER_SHA
ARG UPSTREAM_BASE_SOURCE="https://github.com/OutlineFoundation/tunnel-server"
ARG UPSTREAM_BASE_REVISION=$UPSTREAM_SHA

LABEL org.opencontainers.image.source="$IMAGE_SOURCE" \
      org.opencontainers.image.revision="$IMAGE_REVISION" \
      org.opencontainers.image.version="$IMAGE_VERSION" \
      com.dobbyvpn.outline.upstream-source="https://github.com/OutlineFoundation/tunnel-server" \
      com.dobbyvpn.outline.upstream-revision="$UPSTREAM_SHA" \
      com.dobbyvpn.outline.upstream-commit-date="$UPSTREAM_DATE" \
      com.dobbyvpn.outline.upstream-base-source="$UPSTREAM_BASE_SOURCE" \
      com.dobbyvpn.outline.upstream-base-revision="$UPSTREAM_BASE_REVISION"

COPY --from=build /out/outline-ss-server /outline-ss-server
ENTRYPOINT ["/outline-ss-server"]
CMD ["-config=/etc/secrets/config.yml"]
